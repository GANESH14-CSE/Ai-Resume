# ==========================================
# TRUTHFUL AI RESUME TAILOR - ENVIRONMENT CONFIG
# ==========================================

# Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
# For Docker or production:
DATABASE_URL=postgres://resume_user:resume_password@db:5432/resume_tailor_db
# For local fallback without Postgres running, backend defaults to SQLite if DATABASE_URL is not set or empty.

# Database details for Docker Compose
POSTGRES_DB=resume_tailor_db
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password
POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# LLM Provider Configuration
# Supported providers: anthropic, mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
MOCK_LLM=true

# Single User Authentication / Default User
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_PASSWORD=adminpassword123
DEFAULT_USER_EMAIL=admin@example.com

# Media & Storage
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
